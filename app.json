{
  "expo": {
    "name": "Challengers Fantasy",
    "slug": "challengers-fantasy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/challengers-app-icon-8.png",
    "userInterfaceStyle": "light",
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0E1514",
          "image": "./assets/challengers-wordmark-4.png",
          "imageWidth": 360,
          "resizeMode": "contain"
        }
      ]
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#0E1514",
        "foregroundImage": "./assets/challengers-app-icon-8.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
