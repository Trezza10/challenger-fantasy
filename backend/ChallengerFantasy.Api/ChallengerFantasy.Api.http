@host = http://localhost:5088
@token = paste-clerk-session-token-here
@leagueId = challengers

GET {{host}}/health

###
GET {{host}}/leagues
Authorization: Bearer {{token}}

###
GET {{host}}/leagues/{{leagueId}}/matchup
Authorization: Bearer {{token}}

###
GET {{host}}/leagues/{{leagueId}}/free-agents?limit=20&position=RB
Authorization: Bearer {{token}}

###
POST {{host}}/leagues/{{leagueId}}/cards/plays
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "cardId": "ground-control",
  "playerId": "jahmyr-gibbs"
}

###
PUT {{host}}/leagues/{{leagueId}}/lineup
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "starters": [
    { "slotId": "starter-0", "playerId": "jalen-hurts" },
    { "slotId": "starter-1", "playerId": "jahmyr-gibbs" },
